{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/og-image.png",
      "dest": "/static/og-image.png"
    },
    {
      "src": "/opengraph-image.png",
      "dest": "/static/og-image.png"
    },
    {
      "src": "/widget.js",
      "dest": "/static/widget.js"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/static/index.html"
    }
  ]
}
